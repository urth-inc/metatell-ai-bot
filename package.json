{
  "name": "metatell-ai-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:ui": "vitest run --ui --coverage",
    "test:coverage": "vitest run --coverage",
    "check": "node scripts/run-checks.mjs check",
    "check:fix": "node scripts/run-checks.mjs fix",
    "typecheck": "tsc --build",
    "clean": "pnpm -r run clean",
    "changeset": "changeset",
    "bumpup": "changeset version",
    "release": "pnpm build && changeset publish",
    "typedoc": "typedoc"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@types/node": "24.13.3",
    "@types/phoenix": "1.6.7",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "happy-dom": "20.12.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-missing-exports": "4.1.4",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/urth-inc/metatell-ai-bot"
  },
  "packageManager": "pnpm@11.15.0"
}
