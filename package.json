{
  "name": "metatell-ai-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:ui": "vitest run --ui --coverage",
    "test:coverage": "vitest run --coverage",
    "check": "sh -c 'oxfmt --check --no-error-on-unmatched-pattern \"$@\" && oxlint --max-warnings=0 --no-error-on-unmatched-pattern \"$@\"' --",
    "check:fix": "sh -c 'oxfmt --write --no-error-on-unmatched-pattern \"$@\" && oxlint --fix --max-warnings=0 --no-error-on-unmatched-pattern \"$@\"' --",
    "typecheck": "tsc --build",
    "clean": "pnpm -r clean",
    "changeset": "changeset",
    "bumpup": "changeset version",
    "release": "pnpm build && changeset publish",
    "typedoc": "typedoc"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@types/node": "24.13.3",
    "@types/phoenix": "1.6.7",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "3.2.7",
    "@vitest/ui": "3.2.7",
    "happy-dom": "20.10.6",
    "lefthook": "2.1.10",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-missing-exports": "4.1.4",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/urth-inc/metatell-ai-bot"
  },
  "packageManager": "pnpm@10.34.4"
}
