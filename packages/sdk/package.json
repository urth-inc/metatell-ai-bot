{
  "name": "@metatell/bot-sdk",
  "version": "2.1.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest"
  },
  "dependencies": {
    "@metatell/bot-core": "workspace:*",
    "three": "0.185.1",
    "three-pathfinding": "1.3.0"
  },
  "peerDependencies": {
    "@metatell/bot-realtime": "*",
    "@types/node": "*",
    "@types/ws": "*"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": false
    },
    "@types/ws": {
      "optional": false
    },
    "@metatell/bot-realtime": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@metatell/bot-realtime": "workspace:*"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/phoenix": "1.6.7",
    "@types/three": "0.185.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/urth-inc/metatell-ai-bot",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
