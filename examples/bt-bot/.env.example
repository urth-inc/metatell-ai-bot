# === メタテル接続設定 ===
# ルームのURL（起動時の引数でも指定できる）
METATELL_ROOM_URL=https://metatell.app/YOUR_ROOM_ID
# ボットの認証トークン（OIDCアクセストークン。ボット入室が自由なルームでは空でよい）
METATELL_AUTH_TOKEN=

# === 音声設定（Google Cloud Speech-to-Text / Text-to-Speech + LiveKit） ===
# Speech-to-Text APIとText-to-Speech APIを使えるサービスアカウントJSON。
# 相対パスはbt-botディレクトリ基準。未設定なら音声入出力を無効にする。
GOOGLE_APPLICATION_CREDENTIALS=
# 標準のmetatell.app以外では、環境に対応するLiveKit URLを指定する。
METATELL_REALTIME_URL=
# 認識言語。ボット名は認識精度を上げるフレーズヒントとして自動設定する。
STT_LANGUAGE_CODE=ja-JP
TTS_LANGUAGE_CODE=ja-JP
TTS_VOICE_NAME=ja-JP-Chirp3-HD-Zephyr

# === LLM設定（OpenAI互換のチャットAPI） ===
# ベンダーのOpenAI互換エンドポイント、または中継プロキシ（LiteLLMなど）を指定する。
# 例: GeminiのOpenAI互換エンドポイントを直接使う場合
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_API_KEY=Gemini APIキー
# キーを複数人に配るときは、生のベンダーキーではなく中継プロキシ経由を推奨。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gemini-flash-lite-latest

# === 運営設定 ===
# キルスイッチ（/killall）を使える運営の接続session ID（カンマ区切り）
# 未設定ならリモートキルは無効。再読み込み・再入室などでIDが変わったら更新が必要。
OPERATOR_SESSION_IDS=

# === 実験用フラグ（普段は使わない） ===
# 1にするとLLMのガードプロンプトを外す（プロンプトインジェクションの検証実験専用）
# UNSAFE_MODE=1
# 1にすると他のボットの発言も知覚する（複数ボットが掛け合うデモ演出専用）
# ALLOW_BOT_PERCEPTION=1
# 0にするとコンソールのツリー表示を止める
# BT_TRACE=0
