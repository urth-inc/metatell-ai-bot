# === メタテル接続設定 ===
# ルームのURL（起動時の引数でも指定できる）
METATELL_ROOM_URL=https://metatell.app/YOUR_ROOM_ID
# ボットの認証トークン（OIDCアクセストークン。ボット入室が自由なルームでは空でよい）
METATELL_AUTH_TOKEN=

# === LLM設定（OpenAI互換のチャットAPI） ===
# ベンダーのOpenAI互換エンドポイント、または中継プロキシ（LiteLLMなど）を指定する。
# 例: GeminiのOpenAI互換エンドポイントを直接使う場合
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_API_KEY=Gemini APIキー
# キーを複数人に配るときは、生のベンダーキーではなく中継プロキシ経由を推奨。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gemini-2.5-flash-lite

# === 運営設定 ===
# キルスイッチ（/killall）を使える運営アカウント名（カンマ区切り）
OPERATOR_NAMES=

# === 実験用フラグ（普段は使わない） ===
# 1にするとLLMのガードプロンプトを外す（プロンプトインジェクションの検証実験専用）
# UNSAFE_MODE=1
# 1にすると他のボットの発言も知覚する（複数ボットが掛け合うデモ演出専用）
# ALLOW_BOT_PERCEPTION=1
# 0にするとコンソールのツリー表示を止める
# BT_TRACE=0
